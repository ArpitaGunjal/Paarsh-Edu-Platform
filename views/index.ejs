    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/header') %>

<!-- ================= HERO SECTION ================= -->
<section class="hero">
    <div class="hero-shapes">
        <div class="hero-shape shape-1"></div>
        <div class="hero-shape shape-2"></div>
    </div>

    <div class="container">
        <div class="hero-content">
            <h1>
                Education is the door to the future
                & <span class="highlight">Paarsh Edu</span> is the key to a bright future
            </h1>
            <p>
                We provide innovative and accessible educational solutions, empowering individuals
                to unlock their potential and shape a brighter future.
            </p>

            <div class="hero-buttons">
                <a href="/courses" class="btn btn-primary">View Courses</a>
                <a href="tel:+919075201035" class="btn btn-secondary">
                    <i class="fas fa-phone"></i> +91 90752 01035
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ================= TOP COURSES ================= -->
<section class="top-courses-section">
    <div class="container">

        <div class="section-header">
            <h2>Top Courses</h2>
            <p>Discover top courses to elevate your skills and unlock new opportunities for personal growth.</p>
        </div>

        <div class="courses-slider-wrapper">
            <div class="courses-slider">

                <% if (courses && courses.length > 0) { %>
                <% courses.forEach(course => { %>

                <div class="course-card-pro">
                    <div class="course-image-pro">
                        <img
                            src="<%= course.thumbnail || 'https://source.unsplash.com/600x400/?technology,education' %>"
                            alt="<%= course.title %>"
                        />
                        <span class="course-tag">
                            <%= course.level ? course.level.toUpperCase() : 'BEGINNER' %>
                        </span>
                    </div>

                    <div class="course-content-pro">
                        <h3><%= course.title %></h3>
                        <p><%= course.shortDescription || 'Course description coming soon.' %></p>

                        <div class="course-meta-pro">
                            <span>
                                <i class="fas fa-clock"></i>
                                <%= course.duration || 'N/A' %>
                            </span>
                            <% if (course.certificate) { %>
                            <span><i class="fas fa-certificate"></i> Certificate</span>
                            <% } %>
                        </div>

                        <div class="course-footer-pro">
                            <span class="students">
                                <i class="fas fa-users"></i>
                                <%= course.enrolledCount || 0 %> Students
                            </span>
                            <a href="/course/<%= course._id %>" class="view-btn">View</a>
                        </div>
                    </div>
                </div>

                <% }) %>
                <% } else { %>
                    <p>No courses available.</p>
                <% } %>

            </div>
        </div>
    </div>
</section>

<!-- ================= WHAT WOULD YOU LIKE TO LEARN ================= -->
<section class="learn-section">
    <div class="container">

        <div class="section-header">
            <h2>What Would You Like To <span class="highlight-blue">Learn</span></h2>
            <p>Explore More and more.</p>
        </div>

        <!-- CATEGORY TABS -->
      <div class="category-tabs">
 <button class="category-tab active" data-category="non-it">NON-IT</button>
<button class="category-tab" data-category="languages">LANGUAGES</button>
<button class="category-tab" data-category="graphics-designing">GRAPHICS DESIGNING</button>
<button class="category-tab" data-category="animation">ANIMATION</button>
<button class="category-tab" data-category="cloud-technologies">CLOUD TECHNOLOGIES</button>
<button class="category-tab" data-category="it">IT</button>

</div>



        <!-- COURSES GRID -->
        <div class="courses-grid-learn">

            <% const learnCourses = courses; %>


            <% learnCourses.forEach((course, index) => { 
                const safeTitle = course.title || 'Course';
            %>

           <div class="course-card-learn"
     data-category="<%= course.category?.name
  ?.toLowerCase()
  .replace(/\s+/g, '-') %>"
"

  <a href="/course/<%= course._id %>" class="course-link">

    <div class="course-badge-learn">
      <span class="badge-nonit">
        <%= course.category?.name || 'GENERAL' %>
      </span>
    </div>

    <div class="course-visual">
      <div class="visual-icon">
        <i class="fas fa-<%= index === 0 ? 'chart-bar' : index === 1 ? 'database' : 'brain' %>"></i>
      </div>

      <div class="visual-graphic">
        <img src="<%= course.thumbnail %>" alt="<%= safeTitle %>">
      </div>
    </div>

    <div class="course-details-learn">
      <h3><%= safeTitle %></h3>
      <p><%= course.shortDescription %></p>

      <div class="course-meta-learn">
        <span><i class="fas fa-certificate"></i> Certificate</span>
        <span><i class="fas fa-clock"></i> <%= course.duration %></span>
        <span><i class="fas fa-signal"></i> <%= course.level %></span>
        <span><i class="fas fa-users"></i> <%= course.enrolledCount || 0 %></span>
      </div>

      <div class="course-language-learn">
        <i class="fas fa-globe"></i>
        <%= course.languages?.join(', ') || 'English' %>
      </div>
    </div>

  </a>
</div>


            <% }) %>

        </div>
    </div>
</section>

<!-- ================= ALL OTHER SECTIONS (UNCHANGED) ================= -->
